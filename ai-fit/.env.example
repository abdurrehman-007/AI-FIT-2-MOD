# Export these variables in your shell or hosting dashboard; this file is documentation.
SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=./instance
STORAGE_BACKEND=sqlite
AUTH_BACKEND=local
PUBLIC_URL=http://127.0.0.1:5000
COOKIE_SECURE=0
# Password reset email for local accounts (SMTP over TLS)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=your-sender@gmail.com
# SMTP_USER=your-sender@gmail.com
# SMTP_PASSWORD=your-mail-provider-app-password
# Firebase deployment
# STORAGE_BACKEND=firestore
# AUTH_BACKEND=firebase
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# AI service (server-to-server; use HTTPS outside loopback)
# CATVTON_URL=https://your-private-gpu-service.example
# CATVTON_API_KEY=replace-with-a-random-shared-secret
# Local launcher defaults to balanced; fast trades fabric detail for shorter generation time.
# AIFIT_SPEED_PROFILE=fast
# SIZE_MODEL_PATH=./models/size.joblib
